TIME_ZONE=Asia/Novokuznetsk
# Point this public DNS name to the production server before starting the stack.
DOMAIN=pos.example.com
LETSENCRYPT_EMAIL=admin@example.com
# Optional: set both Dynu API credentials to use DNS-01 when port 80 is unavailable.
# Leave both empty to use HTTP-01.
DYNU_CLIENT_ID=
DYNU_CLIENT_SECRET=
# Replace with a unique, randomly generated Django secret.
DJANGO_SECRET_KEY=
# Set credentials for the initial Django admin user. Existing passwords are not changed.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
