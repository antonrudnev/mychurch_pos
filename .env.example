TIME_ZONE=Asia/Novokuznetsk
# Point this public DNS name to the production server before starting the stack.
DOMAIN=pos.example.com
LETSENCRYPT_EMAIL=admin@example.com
# Replace with a unique, randomly generated Django secret.
