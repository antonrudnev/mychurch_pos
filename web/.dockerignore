# Environment secrets; keep the example template available.
.env
.env.*
!.env.example

# Python environments, bytecode, and test output.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Local databases, including SQLite WAL and SHM files.
*.sqlite3*
*.db
db_volume/

# Local media and generated files.
media/
staticfiles/
*.log

# Git and IDE metadata.
.git/
.gitignore
.vscode/
.idea/
